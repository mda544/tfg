# Obligatorias

# Base de datos PostgreSQL + PostGIS
# Docker:  postgresql+asyncpg://pypacity:pypacity@db:5432/pypacity
# Local:   postgresql+asyncpg://pypacity:pypacity@localhost:5432/pypacity
DATABASE_URL=postgresql+asyncpg://pypacity:pypacity@db:5432/pypacity

# JWT — cambiar por un secreto seguro en producción
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-secret-in-production

# CORS — en producción especificar el dominio del frontend
CORS_ORIGINS=http://localhost:5173

# Opcionales (tienen valores por defecto) 

# API_TITLE=Pypacity API
# API_VERSION=1.0.0
# JWT_ALGORITHM=HS256
# JWT_EXPIRES_MIN=1440
# CLIMATE_CACHE_DIR=climate_cache
# DEM_CACHE_DIR=dem_cache
# ANIO_INICIO_DEFAULT=1990
# ANIO_FIN_DEFAULT=2023